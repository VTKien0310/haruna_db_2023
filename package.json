    "@tailwindcss/postcss": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.23",
    "firebase": "^13.0.0",
    "pinia": "^4.0.3",
    "pwa-asset-generator": "^8.1.7",
    "vue": "^3.5.44",
